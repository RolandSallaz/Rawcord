{
  "name": "rawcord",
  "version": "0.9.2",
  "description": "Self-hosted voice chat with SFU media server",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "npm run build && electron-builder",
    "release": "npm run build && electron-builder --publish always",
    "postinstall": "node scripts/fix-binary-data.cjs",
    "test": "jest --config jest.config.js",
    "test:unit": "jest --config jest.config.js --testPathPattern=unit",
    "test:e2e": "jest --config jest.config.js --testPathPattern=e2e"
  },
  "build": {
    "appId": "com.rawcord.app",
    "productName": "Rawcord",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "node_modules/@shinyoshiaki/binary-data/src/node_modules/**",
      "node_modules/@shinyoshiaki/binary-data/node_modules/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": "AppImage",
      "artifactName": "${productName}-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "artifactName": "${productName}-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "RolandSallaz",
      "repo": "Rawcord",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^28.3.3",
    "electron-builder": "^26.8.1",
    "electron-vite": "^2.3.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.2.6",
    "typescript": "^5.5.2",
    "vite": "^5.3.1"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "buffer": "^6.0.3",
    "date-fns": "^2.30.0",
    "electron-updater": "^6.8.3",
    "events": "^3.3.0",
    "gifenc": "^1.0.3",
    "gifuct-js": "^2.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "util": "^0.12.5",
    "ws": "^8.21.0"
  }
}